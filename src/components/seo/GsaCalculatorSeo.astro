---
import { MIE_TIERS_BY_FY } from "../../data/mieTiers";
import {
  GSA_CALCULATOR_FAQS,
  GSA_STANDARD_FY,
  GSA_STANDARD_LODGING,
  GSA_STANDARD_MIE
} from "../../data/gsaCalculatorFaqs";
import { formatUsd } from "../../lib/format";

const tiers = MIE_TIERS_BY_FY[GSA_STANDARD_FY] ?? [];
const fy = GSA_STANDARD_FY;
---

<section
  class="gsa-seo mt-16 border-t border-[var(--color-border)] pt-12"
  aria-labelledby="gsa-seo-heading"
>
  <article class="mx-auto max-w-3xl">
    <h2 id="gsa-seo-heading" class="text-2xl font-bold tracking-tight text-[var(--color-ink)]">
      How this GSA per diem calculator works
    </h2>

    <div class="mt-6 space-y-4 text-base leading-relaxed text-[var(--color-ink-muted)]">
      <p>
        The U.S. General Services Administration sets <strong class="text-[var(--color-ink)]">CONUS per diem</strong>
        each federal fiscal year (October 1–September 30). Every rate has two parts: a
        <strong class="text-[var(--color-ink)]">lodging</strong> ceiling (before tax, by month) and a daily
        <strong class="text-[var(--color-ink)]">meals &amp; incidental expenses (M&amp;IE)</strong> allowance.
      </p>
      <p>
        For FY{fy}, the <strong class="text-[var(--color-ink)]">standard CONUS rate</strong> is
        {formatUsd(GSA_STANDARD_LODGING)} lodging + {formatUsd(GSA_STANDARD_MIE)} M&amp;IE =
        {formatUsd(GSA_STANDARD_LODGING + GSA_STANDARD_MIE)} per full day. Pick a state and locality (or enter a ZIP)
        and your trip dates. The calculator applies the correct fiscal year, monthly lodging cap, and the
        FTR 75% first- and last-day M&amp;IE rule.
      </p>
      <p>
        Browse <a class="font-medium text-[var(--color-accent)] hover:underline" href="/states/">GSA rates by state</a>
        or read the <a class="font-medium text-[var(--color-accent)] hover:underline" href="/methodology/">methodology</a>.
      </p>
    </div>

    <h3 class="mt-10 text-lg font-semibold text-[var(--color-ink)]">FY{fy} M&amp;IE tiers</h3>
    <p class="mt-2 text-sm text-[var(--color-ink-muted)]">
      First and last travel day = 75% of the M&amp;IE total. Incidentals are {formatUsd(5)} in every tier.
    </p>
    <div class="mt-4 overflow-x-auto rounded-2xl border border-[var(--color-border)]">
      <table class="min-w-full text-left text-sm">
        <thead class="border-b border-[var(--color-border)] bg-[var(--color-surface-muted)]">
          <tr>
            <th class="px-4 py-3 font-semibold text-[var(--color-ink)]">M&amp;IE total</th>
            <th class="px-4 py-3 font-semibold text-[var(--color-ink)]">Breakfast</th>
            <th class="px-4 py-3 font-semibold text-[var(--color-ink)]">Lunch</th>
            <th class="px-4 py-3 font-semibold text-[var(--color-ink)]">Dinner</th>
            <th class="px-4 py-3 font-semibold text-[var(--color-ink)]">First/last day (75%)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[var(--color-border)]">
          {
            tiers.map((t) => (
              <tr class="bg-[var(--color-surface-elevated)]">
                <td class="px-4 py-3 font-medium text-[var(--color-ink)]">{formatUsd(t.total)}</td>
                <td class="px-4 py-3 text-[var(--color-ink-muted)]">{formatUsd(t.breakfast)}</td>
                <td class="px-4 py-3 text-[var(--color-ink-muted)]">{formatUsd(t.lunch)}</td>
                <td class="px-4 py-3 text-[var(--color-ink-muted)]">{formatUsd(t.dinner)}</td>
                <td class="px-4 py-3 text-[var(--color-ink)]">{formatUsd(t.total * 0.75)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h3 class="mt-10 text-lg font-semibold text-[var(--color-ink)]" id="gsa-faq-heading">
      Frequently asked questions
    </h3>
    <div class="mt-4 space-y-3">
      {
        GSA_CALCULATOR_FAQS.map((f) => (
          <details class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-elevated)] px-5 py-4">
            <summary class="cursor-pointer font-semibold text-[var(--color-ink)]">{f.q}</summary>
            <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-muted)]">{f.a}</p>
          </details>
        ))
      }
    </div>
  </article>
</section>
