---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import { ThemeToggle } from "../components/ThemeToggle";

type Props = {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  hero?: boolean;
};

const { title, description, jsonLd, hero = false } = Astro.props;

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : new URL(Astro.url.pathname, Astro.url.origin).href;

const navLink =
  "text-sm font-medium text-[var(--color-ink-muted)] transition hover:text-[var(--color-ink)]";
const navActive = "text-sm font-semibold text-[var(--color-accent)]";
const path = Astro.url.pathname;

const onCalculator = path.startsWith("/calculator");
const onStates = path.startsWith("/states");
const onGuides = path.startsWith("/guides") || path.startsWith("/crew/");
const onBlog = path.startsWith("/blog");
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() ?? "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="rqHJJaEQbj6xuExGiomRra_kSJ4IZqVDAMvdBA-6Ca0" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {
      gaId ? (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              window.dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", gaId);
          </script>
        </>
      ) : null
    }
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const dark = stored === "dark";
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
    {
      jsonLd ? (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(
            Array.isArray(jsonLd)
              ? { "@context": "https://schema.org", "@graph": jsonLd }
              : jsonLd
          )}
        />
      ) : null
    }
  </head>
  <body class:list={["min-h-dvh antialiased", hero ? "bg-mesh" : "bg-[var(--color-surface)]"]}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-[var(--color-surface-elevated)] focus:px-3 focus:py-2 focus:shadow"
      >Skip to content</a
    >

    <header class="glass sticky top-0 z-40 border-b border-[var(--color-border)]">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3.5 sm:px-6">
        <a href="/" class="flex items-center gap-2.5">
          <span
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[var(--color-ink)] text-sm font-bold text-white"
            >PD</span
          >
          <span class="flex min-w-0 flex-col leading-tight">
            <span class="text-base font-bold tracking-tight text-[var(--color-ink)] sm:text-lg"
              >PerDiemCalculator</span
            >
            <span
              class="mt-0.5 text-[0.6875rem] font-medium tracking-wide text-[var(--color-ink-muted)] sm:text-xs"
            >
              GSA per diem calculator
            </span>
          </span>
        </a>
        <nav class="flex flex-wrap items-center gap-x-5 gap-y-2" aria-label="Main">
          <a href="/calculator/" class={onCalculator ? navActive : navLink}>Calculators</a>
          <a href="/states/" class={onStates ? navActive : navLink}>States</a>
          <a href="/guides/" class={onGuides ? navActive : navLink}>Guides</a>
          <a href="/blog/" class={onBlog ? navActive : navLink}>Blog</a>
          <a
            href="/#gsa-calculator"
            class="rounded-lg bg-[var(--color-accent)] px-3 py-1.5 text-sm font-semibold text-white hover:opacity-90"
          >
            Calculate
          </a>
          <ThemeToggle client:load />
        </nav>
      </div>
    </header>

    <main id="main" class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
