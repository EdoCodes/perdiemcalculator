---
import BaseLayout from "../layouts/BaseLayout.astro";
import { HomeCalculatorHub } from "../components/home/HomeCalculatorHub";
import HomeHowItWorks from "../components/home/HomeHowItWorks.astro";
import { PerDiemCalculator } from "../components/calculator/PerDiemCalculator";
import { EmbedOnYourSite } from "../components/widget/EmbedCodeCard";
import { US_STATES } from "../data/usStates";
import { GSA_CALCULATOR_FAQS } from "../data/gsaCalculatorFaqs";

const title = "Per Diem Calculator 2026 — GSA Lodging & M&IE Rates";
const description =
  "Free 2026 GSA per diem calculator: look up CONUS lodging and M&IE by city, ZIP, or state, including the 75% first- and last-day travel rule.";

const siteUrl = Astro.site?.href ?? Astro.url.origin;

const jsonLd = [
  {
    "@type": "WebApplication",
    name: "GSA Per Diem Calculator",
    alternateName: [
      "Per diem calculator",
      "Federal per diem calculator",
      "CONUS per diem calculator",
      "GSA lodging calculator",
      "M&IE calculator"
    ],
    applicationCategory: "FinanceApplication",
    operatingSystem: "Any",
    url: siteUrl,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    description
  },
  {
    "@type": "WebSite",
    name: "PerDiemCalculator",
    url: siteUrl,
    description
  },
  {
    "@type": "FAQPage",
    mainEntity: GSA_CALCULATOR_FAQS.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a }
    }))
  }
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} hero>
  <section class="max-w-3xl" aria-labelledby="home-h1">
    <h1
      id="home-h1"
      class="font-display text-3xl tracking-tight text-[var(--color-ink)] sm:text-4xl lg:text-[2.75rem]"
    >
      GSA per diem calculator
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-muted)]">
      Look up FY2026 federal lodging and meals &amp; incidental (M&amp;IE) rates by city, ZIP, or
      state—including the 75% first- and last-day travel rule.
    </p>
  </section>

  <section
    id="gsa-calculator"
    class="calculator-theme calc-panel mt-10 -mx-4 rounded-2xl px-4 py-8 sm:mx-0 sm:px-8 sm:py-10"
    aria-label="GSA per diem calculator"
  >
    <div class="mb-4">
      <EmbedOnYourSite client:load />
    </div>
    <PerDiemCalculator client:load />
  </section>

  <HomeHowItWorks />

  <section class="mt-20" aria-labelledby="by-profession-heading">
    <h2 id="by-profession-heading" class="font-display text-2xl sm:text-3xl">
      Calculators by profession
    </h2>
    <p class="mt-2 text-sm text-[var(--color-ink-muted)]">
      Airline crew, teachers, truck drivers, travel nurses, and more use different rate systems.
    </p>
    <div class="mt-8">
      <HomeCalculatorHub client:load />
    </div>
  </section>

  <section class="mt-24">
    <h2 class="font-display text-2xl sm:text-3xl">Browse GSA per diem rates by state</h2>
    <p class="mt-2 text-sm text-[var(--color-ink-muted)]">
      Locality tables for federal travelers and contractors—lodging caps and M&amp;IE by destination.
    </p>
    <ul class="mt-6 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {
        US_STATES.map((s) => (
          <li>
            <a
              href={`/states/${s.abbr.toLowerCase()}/`}
              class="group flex items-center justify-between rounded-lg border border-[var(--color-border-strong)] bg-[var(--color-surface-elevated)] px-4 py-3 transition hover:border-[var(--color-accent)]"
            >
              <span class="font-medium text-[var(--color-ink)]">{s.name}</span>
              <span class="text-xs font-bold text-[var(--color-ink-muted)]">{s.abbr}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-right">
      <a href="/states/" class="text-sm font-semibold text-[var(--color-accent)] hover:underline">
        View all states →
      </a>
    </p>
  </section>
</BaseLayout>
