---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { EmbedCodeCard } from "../../components/widget/EmbedCodeCard";
import { DEFAULT_SITE_URL } from "../../config/sitemapSeo";
import { WIDGET_IFRAME_HEIGHT, WIDGET_IFRAME_MAX_WIDTH } from "../../lib/widget/embedSnippet";

const title = "Free GSA Per Diem Calculator Widget for Your Website (2026 Embed)";
const description =
  "Add the official FY2026 GSA lodging and M&IE calculator to your site with one HTML snippet. Free for travel managers, agencies, and publishers.";

const siteUrl = Astro.site?.href ?? DEFAULT_SITE_URL;
const pageUrl = new URL("/widget/", siteUrl).href;

const faqs = [
  {
    q: "Is the per diem calculator widget free to use?",
    a: "Yes. The embeddable GSA calculator is free for travel managers, government contractors, employee intranet sites, blogs, and educational publishers."
  },
  {
    q: "How are GSA lodging and M&IE rates updated?",
    a: "The widget loads published GSA CONUS rates from our database. When we sync a new fiscal year, embedded copies update automatically—you do not change the snippet."
  },
  {
    q: "Does the widget work on mobile devices?",
    a: `Yes. The iframe scales from about 320px to ${WIDGET_IFRAME_MAX_WIDTH}px wide. Use height="${WIDGET_IFRAME_HEIGHT}" as a starting point; visitors can scroll inside the frame for the day-by-day table.`
  },
  {
    q: "How do I add the widget to WordPress, Wix, or Squarespace?",
    a: "Copy the HTML snippet on this page and paste it into a Custom HTML block (WordPress), Embed HTML element (Wix), or Code block (Squarespace)."
  }
];

const jsonLd = [
  {
    "@type": "WebPage",
    name: title,
    url: pageUrl,
    description
  },
  {
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a }
    }))
  }
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} hero>
  <section class="mx-auto max-w-3xl text-center">
    <p
      class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border-strong)] bg-[var(--color-surface-elevated)] px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-accent)]"
    >
      <span aria-hidden>{"</>"}</span>
      Webmaster tools
    </p>
    <h1 class="font-display mt-5 text-3xl sm:text-4xl lg:text-[2.75rem]">
      Free GSA per diem calculator widget for your website
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-muted)]">
      Add our FY2026 GSA lodging and meals &amp; incidental (M&amp;IE) calculator with one HTML
      snippet. Built for travel managers, federal contractors, and finance publishers.
    </p>
  </section>

  <section
    class="mx-auto mt-10 max-w-3xl rounded-2xl border border-[var(--color-border-strong)] bg-[var(--color-surface-elevated)] px-5 py-8 shadow-[0_8px_24px_-12px_rgba(0,33,71,0.14)] sm:px-8"
    aria-labelledby="copy-embed-heading"
  >
    <h2 id="copy-embed-heading" class="font-display text-2xl text-[var(--color-ink)]">
      Copy your embed code
    </h2>
    <p class="mt-2 text-sm text-[var(--color-ink-muted)]">
      Paste this snippet into your website or CMS. The iframe always loads the latest GSA rates from
      PerDiemCalculator.com.
    </p>
    <div class="mt-6">
      <EmbedCodeCard client:load />
    </div>

    <h3 class="mt-10 text-base font-semibold text-[var(--color-ink)]">Widget specifications</h3>
    <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-[var(--color-ink-muted)]">
      <li>
        <strong class="text-[var(--color-ink)]">Responsive:</strong> scales from about 320px to {WIDGET_IFRAME_MAX_WIDTH}px
        wide
      </li>
      <li>
        <strong class="text-[var(--color-ink)]">Recommended height:</strong> {WIDGET_IFRAME_HEIGHT}px
      </li>
      <li>
        <strong class="text-[var(--color-ink)]">Data:</strong> published GSA CONUS lodging caps and M&amp;IE
        (FY2026), including the 75% first- and last-day rule
      </li>
      <li>
        <strong class="text-[var(--color-ink)]">Maintenance:</strong> none. Rate updates sync on our side
      </li>
    </ul>
  </section>

  <section class="mx-auto mt-10 max-w-3xl" aria-labelledby="live-preview-heading">
    <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
      <h2 id="live-preview-heading" class="font-display text-2xl">Live preview</h2>
      <a class="text-sm font-semibold text-[var(--color-accent)] hover:underline" href="/embed/" target="_blank" rel="noopener">
        Open preview ↗
      </a>
    </div>
    <iframe
      src="/embed/"
      title="GSA per diem calculator widget preview"
      width="100%"
      height={WIDGET_IFRAME_HEIGHT}
      class="w-full max-w-[680px] rounded-xl border-0 shadow-[0_4px_20px_rgba(0,0,0,0.08)]"
    ></iframe>
  </section>

  <section class="mx-auto mt-16 max-w-3xl" aria-labelledby="install-heading">
    <h2 id="install-heading" class="font-display text-2xl sm:text-3xl">How to install in 2 minutes</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <article class="rounded-2xl border border-[var(--color-border-strong)] bg-[var(--color-surface-elevated)] p-5">
        <h3 class="font-semibold text-[var(--color-ink)]">WordPress</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)]">
          Open your page or post editor. Click + Add Block and select Custom HTML. Paste the snippet
          and publish.
        </p>
      </article>
      <article class="rounded-2xl border border-[var(--color-border-strong)] bg-[var(--color-surface-elevated)] p-5">
        <h3 class="font-semibold text-[var(--color-ink)]">Wix</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)]">
          Click + Add Elements. Select Embed Code → Embed HTML. Paste the snippet and set width to
          100%.
        </p>
      </article>
      <article class="rounded-2xl border border-[var(--color-border-strong)] bg-[var(--color-surface-elevated)] p-5">
        <h3 class="font-semibold text-[var(--color-ink)]">Squarespace</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)]">
          Edit the section, Add Block, choose Code. Set mode to HTML, paste the snippet, and save.
        </p>
      </article>
      <article class="rounded-2xl border border-[var(--color-border-strong)] bg-[var(--color-surface-elevated)] p-5">
        <h3 class="font-semibold text-[var(--color-ink)]">Custom HTML / Webflow</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)]">
          Paste the snippet into your HTML template, a Webflow Embed component, or a static-site
          markdown layout.
        </p>
      </article>
    </div>
  </section>

  <section class="mx-auto mt-16 max-w-3xl" aria-labelledby="who-heading">
    <h2 id="who-heading" class="font-display text-2xl sm:text-3xl">Who uses this calculator</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      <article class="rounded-2xl border border-[var(--color-border-strong)] bg-[var(--color-surface-elevated)] p-5">
        <h3 class="font-semibold text-[var(--color-ink)]">Travel managers</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)]">
          Let employees estimate GSA lodging and M&amp;IE before they file a voucher or book a trip.
        </p>
      </article>
      <article class="rounded-2xl border border-[var(--color-border-strong)] bg-[var(--color-surface-elevated)] p-5">
        <h3 class="font-semibold text-[var(--color-ink)]">Federal contractors</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)]">
          Put the same CONUS rates your contracts reference on an intranet or proposal site.
        </p>
      </article>
      <article class="rounded-2xl border border-[var(--color-border-strong)] bg-[var(--color-surface-elevated)] p-5">
        <h3 class="font-semibold text-[var(--color-ink)]">Publishers &amp; blogs</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)]">
          Embed a working FY2026 calculator next to travel policy explainers instead of a static
          table.
        </p>
      </article>
    </div>
  </section>

  <section class="mx-auto mt-16 max-w-3xl" aria-labelledby="widget-faq-heading">
    <h2 id="widget-faq-heading" class="font-display text-2xl sm:text-3xl">Frequently asked questions</h2>
    <div class="mt-6 space-y-3">
      {
        faqs.map((f) => (
          <details class="rounded-xl border border-[var(--color-border-strong)] bg-[var(--color-surface-elevated)] px-5 py-4">
            <summary class="cursor-pointer font-semibold text-[var(--color-ink)]">{f.q}</summary>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)]">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</BaseLayout>
